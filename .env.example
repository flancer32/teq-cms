# Demo configuration for teq-cms standalone server
TEQ_CMS__BASE_URL=https://cms.teqfw.com
# Optional Markdown publication (requires an absolute TEQ_CMS__BASE_URL)
# TEQ_CMS__PUBLICATION_FAMILIES=[{"prefix":"journal","presentation":"publication.html"}]
# TEQ_CMS__PUBLICATION_MACHINE_LOCALES=en
# Optional private agent contact inbox
# TEQ_CMS__AGENT_MESSAGE_ENABLED=true
# TEQ_CMS__AGENT_MESSAGE_TOKEN=replace-with-a-secret
TEQFW_TMPL__ALLOWED_LOCALES=en,es,ru
TEQFW_TMPL__DEFAULT_LOCALE=en
TEQFW_TMPL__ENGINE=nunjucks
TEQFW_WEB__PORT=3000
TEQFW_WEB__TYPE=http
